PORT=3004
# MahaSetu Core, called only from this site's server.
CORE_API_URL=http://localhost:8000
# Server credential for Core's website surface. At least 24 random characters; never commit a real value.
DASHBOARD_CLIENT_TOKEN=
# Set to false only for local HTTP demonstrations. The session cookie is HttpOnly either way.
COOKIE_SECURE=true
# Simulated SMS inbox at /messages. Demonstration only: it shows one-time codes in development and has no sign-in.
DEMO_MESSAGE_INBOX=enabled
SUPABASE_PUBLISHABLE_KEY=
